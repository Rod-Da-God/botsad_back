# Безопасные фиктивные значения для unit-тестов.
# Никаких реальных подключений: БД, Redis, Kafka, S3, внешние API.

# FastAPI
HOST=127.0.0.1
PORT=8000
UC_LOG_LEVEL=critical

# Логи
LOG_LEVEL=INFO
LOG_TO_CONSOLE=false
LOG_TO_FILE=false

# OpenTelemetry
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=backend-test
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# База данных (заведомо нерабочие значения)
DB_DIALECT=postgresql
DB_DRIVER=asyncpg
DB_USER=test_user
DB_PASSWORD=test_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=test_db
DB_SSL_ENABLED=false

# Кэш / Redis (заведомо нерабочие значения)
CACHE_HOST=127.0.0.1
CACHE_PORT=6379

# Bitrix24
BITRIX_WEBHOOK_URL=http://localhost/rest/1/test/
BITRIX_ENTITY_TYPE_ID=1038

# Подсказки адресов
SUGGEST_API_KEY=test-key

# S3 (заведомо нерабочие значения)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=test-bucket
AWS_ACCESS_KEY=test-access-key
AWS_SECRET_KEY=test-secret-key
S3_REGION=ru-test-1

# Исходящие вебхуки
WEBHOOK_BASE_URL=https://webhook.test/

# Геокодер и сервис районов
YANDEX_GEOCODER_API_KEY=test
DISTRICTS_SERVICE_URL=http://localhost

# Аналитика отключена: пустые значения не должны тянуть реальный DSN
ANALYTICS_DB_DSN=
ANALYTICS_DB_USER=
ANALYTICS_DB_PASSWORD=
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=
