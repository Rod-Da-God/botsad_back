# =========================
# Логирование
# =========================
LOG_LEVEL=INFO
LOG_FILE=app.log
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_ROTATION=10 MB
LOG_RETENTION=10 days
LOG_COMPRESSION=zip
LOG_MAX_FRAMES=10

# =========================
# FastAPI
# =========================
HOST=0.0.0.0
PORT=8000
# Уровень логов uvicorn: critical | error | warning | info | debug
UC_LOG_LEVEL=critical

# =========================
# PostgreSQL (основная БД)
# =========================
DB_DIALECT=postgresql
DB_DRIVER=asyncpg
DB_USER=postgres
DB_PASSWORD=change-me
# В docker compose — postgres, локально — localhost
DB_HOST=localhost
# Порт на хосте из docker-compose — 55432
DB_PORT=5432
DB_NAME=postgres
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT=30
# SSL для удалённой БД; для локального postgres выключить
DB_SSL_ENABLED=false
DB_SSL_MODE=require
DB_SSL_CA_PATH=
DB_SSL_CERT_PATH=
DB_SSL_KEY_PATH=

# =========================
# Redis (кэш + broadcast)
# =========================
CACHE_USER=
CACHE_PASSWORD=
# В docker compose — redis, локально — localhost
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_DB=0
BROADCAST_DB=1
CACHE_DECODE_RESPONSES=true
CACHE_MAX_CONNECTIONS=10
CACHE_SOCKET_TIMEOUT=5
CACHE_SOCKET_CONNECT_TIMEOUT=10

# =========================
# Bitrix24
# =========================
# REST webhook вида https://<portal>.bitrix24.ru/rest/<user>/<token>/
BITRIX_WEBHOOK_URL=
# Название смарт-процесса с конструкциями
BITRIX_SPA_TITLE=Конструкции
# Фолбэк entityTypeId, если crm.type.list недоступен (можно оставить пустым)
BITRIX_ENTITY_TYPE_ID=

# =========================
# Геокодер и районы
# =========================
YANDEX_GEOCODER_API_KEY=
DISTRICTS_SERVICE_URL=

# =========================
# S3 (фото конструкций)
# =========================
S3_ENDPOINT=
S3_BUCKET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
S3_REGION=

# =========================
# Подсказки адресов (DaData)
# =========================
SUGGEST_API_KEY=
SUGGEST_BASE_URL=https://suggestions.dadata.ru/suggestions/api/4_1/rs
SUGGEST_TIMEOUT=10.0
SUGGEST_MAX_SUGGESTIONS=10

# =========================
# Аналитика (отдельная БД, опционально)
# =========================
# Можно задать один DSN вместо набора полей ниже
ANALYTICS_DB_DSN=
ANALYTICS_DB_USER=
ANALYTICS_DB_PASSWORD=
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=
ANALYTICS_DB_POOL_SIZE=5
ANALYTICS_DB_CONNECT_TIMEOUT=30

# =========================
# Исходящие вебхуки (опционально)
# =========================
# Если не задан — приложение стартует, уведомления не отправляются.
# События уходят на <WEBHOOK_BASE_URL>/events
WEBHOOK_BASE_URL=
WEBHOOK_TIMEOUT=10.0
WEBHOOK_RETRIES=0
WEBHOOK_BACKOFF_FACTOR=0.5

# =========================
# Трассировка (OpenTelemetry / Tempo)
# =========================
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_RESOURCE_ATTRIBUTES="service.namespace=botsad"
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS="health,metrics"
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_SCHEDULE_DELAY_MS=5000
OTEL_EXPORTER_OTLP_TIMEOUT=3
